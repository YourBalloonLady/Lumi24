{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumi24",
  "compatibility_date": "2026-04-27",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
